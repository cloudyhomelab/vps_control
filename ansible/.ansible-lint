---
# No rules are skipped. Every role variable is role-prefixed
# (var-naming[no-role-prefix]); see each role's argument_specs.yml.
#
# Lives in ansible/ rather than the repo root because that is the cwd the CI lint job
# uses — which also keeps .github/ outside the scanned tree, so workflow YAML is never
# linted as Ansible content.
profile: production

# An app's SOPS-encrypted secrets are data, not Ansible content: the file is a map of
# names to ENC[...] blobs whose length nothing here controls, so yaml[line-length] has
# nothing useful to say about it. Excluded as a file rather than silenced as a rule, so
# line length stays enforced everywhere it means something.
exclude_paths:
  - "**/secrets.sops.yaml"

# Fixture: a plain systemd unit, installed beside the Quadlet from the app's unit/
# directory. Oneshot with RemainAfterExit so it stays 'active' for the verifier, and
# with an [Install] section so `systemctl enable` succeeds on it — unlike a
# Quadlet-generated service, which is the other half of the role's enable path.
[Unit]
Description=Molecule fixture plain unit

[Service]
Type=oneshot
RemainAfterExit=true
ExecStart=/bin/true

[Install]
WantedBy=multi-user.target

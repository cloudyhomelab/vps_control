[Unit]
Description=Weekly reclaim of dangling container images

[Timer]
# Sunday 04:00, two hours after the package-update window, so a reboot triggered there
# does not interrupt a prune. Persistent catches the run if the host was down for it.
OnCalendar=Sun *-*-* 04:00:00
RandomizedDelaySec=1800
Persistent=true

[Install]
WantedBy=timers.target

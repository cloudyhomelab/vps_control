[Unit]
Description=Caddy reverse proxy
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/library/caddy:latest
AutoUpdate=registry
# Liveness probe guarding that auto-update: the admin API answers only once Caddy
# has parsed and loaded the Caddyfile, so an image that boots but cannot serve is
# visible as unhealthy instead of silently proxying nothing. Reachable only from
# inside the container, same as ExecReload below. Addressed as 127.0.0.1, not
# localhost: musl resolves that to ::1 first, where nothing is listening.
HealthCmd=wget -qO /dev/null http://127.0.0.1:2019/config/ || exit 1
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=10s
# What turns the probe above into a rollback trigger: systemd withholds "started"
# until the first probe passes, so `podman auto-update --rollback` sees a bad image
# as a failed start and reverts it. Without this the unit counts as up the moment
# the container launches, whatever it then serves. Needs podman >= 4.7 (host: 5.4.2).
Notify=healthy
# Only 443 is published — TLS-ALPN-01 handles ACME over HTTPS, so port 80
# is not needed (TCP for HTTPS, UDP for HTTP/3).
PublishPort=443:443
PublishPort=443:443/udp
# Shared network with the upstreams, so they resolve by name (e.g. calculators).
Network=web.network
# a single-file bind mount follows the inode, so updated files never reaches the running container, hence binding the directory instead
Volume=/var/app/reverse_proxy/config:/etc/caddy:ro,Z
Volume=caddy-data.volume:/data
Volume=caddy-config.volume:/config

[Service]
Restart=always
# A Quadlet container unit has no reload action by default, so define one: routes
# change on every app add/remove, and a full restart would drop live connections.
# Caddy swaps config in place via its admin API, which is only reachable from
# inside the container — hence podman exec into the default systemd-<unit> name.
ExecReload=/usr/bin/podman exec systemd-caddy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile

[Install]
WantedBy=multi-user.target default.target
